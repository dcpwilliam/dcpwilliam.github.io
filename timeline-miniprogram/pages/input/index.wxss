.page {
  padding-bottom: 180rpx;
}

/* 当前目标速览 */
.cur {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(27, 31, 51, 0.04);
}
.cur-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 7rpx;
  margin-right: 14rpx;
  flex: none;
}
.cur-title {
  font-size: 27rpx;
  color: #1b1f33;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cur-right {
  display: flex;
  align-items: center;
  flex: none;
}
.cur-p {
  font-size: 26rpx;
  font-weight: 700;
  color: #5b6cff;
  margin-right: 8rpx;
}
.arrow {
  font-size: 30rpx;
  color: #c2c8d8;
}

/* 会话 */
.chat {
  padding-bottom: 20rpx;
}
.row-me {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 16rpx;
}
.bubble {
  max-width: 88%;
  border-radius: 22rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
}
.bubble.me {
  background: linear-gradient(135deg, #6f7dff, #5b6cff);
  color: #fff;
  border-bottom-right-radius: 8rpx;
  box-shadow: 0 8rpx 20rpx rgba(91, 108, 255, 0.22);
}
.b-text {
  font-size: 29rpx;
  line-height: 1.6;
}
.b-time {
  margin-top: 8rpx;
  font-size: 20rpx;
  opacity: 0.7;
  text-align: right;
}
.bubble.ai {
  background: #fff;
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 6rpx 22rpx rgba(27, 31, 51, 0.05);
}

.ai-head {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}
.intent {
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-size: 21rpx;
  margin-right: 12rpx;
}
.src {
  margin-left: auto;
  padding: 3rpx 12rpx;
  border-radius: 14rpx;
  background: #eafaf1;
  color: #0ca678;
  font-size: 19rpx;
  flex: none;
}
.src.off {
  background: #f2f4fa;
  color: #a6aebc;
}
.cat {
  font-size: 21rpx;
  color: #a6aebc;
}
.summary {
  font-size: 28rpx;
  line-height: 1.75;
  color: #1b1f33;
}

.goal-card {
  margin-top: 20rpx;
  background: #f7f8fc;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
}
.gc-label {
  font-size: 20rpx;
  color: #a6aebc;
}
.gc-title {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1b1f33;
  line-height: 1.5;
  border-left: 6rpx solid #5b6cff;
  padding-left: 14rpx;
}
.gc-cri,
.gc-metric {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8a91a6;
  line-height: 1.6;
}
.gc-metric {
  color: #5b6cff;
}

.sug {
  display: flex;
  margin-top: 18rpx;
}
.sug-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 5rpx;
  margin: 12rpx 14rpx 0 0;
  flex: none;
}
.sug-body {
  flex: 1;
}
.sug-t {
  font-size: 27rpx;
  color: #1b1f33;
  line-height: 1.55;
}
.sug-tip {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #a6aebc;
  line-height: 1.5;
}

.acts {
  display: flex;
  flex-wrap: wrap;
  margin-top: 22rpx;
}
.act {
  padding: 14rpx 26rpx;
  border-radius: 32rpx;
  font-size: 25rpx;
  color: #4a5168;
  background: #f2f4fa;
  margin: 0 14rpx 12rpx 0;
}
.act.primary {
  background: linear-gradient(135deg, #6f7dff, #5b6cff);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(91, 108, 255, 0.25);
}
.act.done {
  background: #e8f8f2;
  color: #12b886;
}

.typing {
  display: flex;
  align-items: center;
  height: 40rpx;
}
.typing text {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: #d8dced;
  margin-right: 10rpx;
  animation: blink 1s infinite;
}
.typing text:nth-child(2) {
  animation-delay: 0.2s;
}
.typing text:nth-child(3) {
  animation-delay: 0.4s;
}
@keyframes blink {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 1; }
}

/* 空态 */
.welcome {
  padding: 80rpx 30rpx 40rpx;
  text-align: center;
}
.w-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1b1f33;
}
.w-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #8a91a6;
  line-height: 1.8;
}
.chips {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 40rpx;
}
.chip {
  padding: 14rpx 24rpx;
  margin: 0 14rpx 16rpx 0;
  border-radius: 32rpx;
  background: #fff;
  color: #4a5168;
  font-size: 25rpx;
  box-shadow: 0 4rpx 16rpx rgba(27, 31, 51, 0.05);
}

.pad {
  height: 20rpx;
}

/* 输入栏 */
.composer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: flex-end;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 2rpx solid #f0f2f8;
  z-index: 20;
}
.mic {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: #f2f4fa;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  margin-right: 16rpx;
}
.mic:active {
  background: linear-gradient(135deg, #ff8a6b, #ff6b6b);
}
.mic:active .mic-i {
  background: #fff;
}
.mic:active .mic-i::after {
  border-color: #fff;
  border-top-color: transparent;
}
.mic-i {
  width: 22rpx;
  height: 30rpx;
  border-radius: 11rpx;
  background: #8a91a6;
  position: relative;
}
.mic-i::after {
  content: '';
  position: absolute;
  left: -6rpx;
  top: 14rpx;
  width: 34rpx;
  height: 20rpx;
  border: 4rpx solid #8a91a6;
  border-top-color: transparent;
  border-radius: 17rpx;
  box-sizing: border-box;
}
.inp {
  flex: 1;
  min-height: 72rpx;
  max-height: 180rpx;
  background: #f5f6fa;
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #1b1f33;
}
.ph {
  color: #b6bccd;
  font-size: 26rpx;
}
.send {
  flex: none;
  margin-left: 16rpx;
  padding: 0 30rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #6f7dff, #5b6cff);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(91, 108, 255, 0.25);
}
.send.off {
  background: #dfe2ee;
  color: #a6aebc;
  box-shadow: none;
}


