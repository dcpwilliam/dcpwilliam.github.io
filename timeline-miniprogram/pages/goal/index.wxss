.stat {
  padding: 26rpx 24rpx;
}
.stat-row {
  display: flex;
}
.stat-cell {
  flex: 1;
  text-align: center;
}
.sn {
  font-size: 44rpx;
  font-weight: 800;
  color: #1b1f33;
  line-height: 1;
}
.sn.done { color: #12b886; }
.sn.week { color: #5b6cff; }
.sl {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8a91a6;
}
.auto-note {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #f0f2f8;
  font-size: 22rpx;
  color: #a6aebc;
  line-height: 1.6;
}

.gcard {
  padding: 26rpx 24rpx;
  margin-top: 20rpx;
}
.gcard.is-done {
  opacity: 0.72;
}
.g-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.g-left {
  flex: 1;
  min-width: 0;
}
.g-title {
  font-size: 31rpx;
  font-weight: 600;
  color: #1b1f33;
  line-height: 1.5;
  border-left: 8rpx solid #5b6cff;
  padding-left: 16rpx;
}
.g-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
  padding-left: 24rpx;
}
.g-tag {
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  margin-right: 10rpx;
}
.g-tag.grey {
  background: #f2f4fa;
  color: #8a91a6;
}
.g-right {
  flex: none;
  display: flex;
  align-items: center;
  margin-left: 16rpx;
}
.g-p {
  font-size: 40rpx;
  font-weight: 800;
  color: #1b1f33;
  line-height: 1;
}
.g-pct {
  font-size: 22rpx;
  color: #a6aebc;
}
.arrow {
  font-size: 30rpx;
  color: #c2c8d8;
  margin-left: 14rpx;
  transform: rotate(90deg);
  transition: transform 0.2s ease;
}
.arrow.up {
  transform: rotate(-90deg);
}

.bar {
  margin-top: 22rpx;
  height: 10rpx;
  border-radius: 5rpx;
  background: #eef0f7;
  overflow: hidden;
}
.bar-in {
  height: 100%;
  border-radius: 5rpx;
  transition: width 0.3s ease;
}
.g-metric {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8a91a6;
}

.advice {
  margin-top: 18rpx;
  background: #f7f8fc;
  border-radius: 14rpx;
  padding: 16rpx 18rpx;
  display: flex;
}
.advice-k {
  flex: none;
  font-size: 21rpx;
  color: #5b6cff;
  margin-right: 14rpx;
}
.advice-v {
  flex: 1;
  font-size: 23rpx;
  color: #4a5168;
  line-height: 1.6;
}

.g-body {
  margin-top: 24rpx;
  border-top: 2rpx dashed #eceef5;
  padding-top: 18rpx;
}
.sec-title {
  font-size: 22rpx;
  color: #a6aebc;
  margin-bottom: 12rpx;
}
.men {
  display: flex;
  margin-bottom: 14rpx;
}
.men-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 5rpx;
  margin: 12rpx 14rpx 0 0;
  flex: none;
}
.men-body { flex: 1; }
.men-text {
  font-size: 25rpx;
  color: #1b1f33;
  line-height: 1.55;
}
.men-meta {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #b6bccd;
}
.cri {
  font-size: 23rpx;
  color: #8a91a6;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.g-acts {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}
.ga {
  padding: 14rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #4a5168;
  background: #f2f4fa;
  margin: 0 12rpx 12rpx 0;
}
.ga.primary {
  background: linear-gradient(135deg, #6f7dff, #5b6cff);
  color: #fff;
  font-weight: 600;
}
.ga.danger {
  color: #e64980;
  background: #fdeef4;
}

.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  color: #8a91a6;
  font-size: 26rpx;
  line-height: 1.8;
}
.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #4a5168;
  margin-bottom: 14rpx;
}
.go {
  margin: 40rpx 100rpx 0;
}
