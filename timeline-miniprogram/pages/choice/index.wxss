.need-card {
  padding: 28rpx;
}
.need-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.need-label {
  font-size: 22rpx;
  color: #a6aebc;
}
.switch {
  font-size: 23rpx;
  color: #5b6cff;
}
.need-text {
  margin-top: 12rpx;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.5;
  color: #1b1f33;
}
.need-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}
.tag.gray {
  background: #f2f4fa;
  color: #8a91a6;
  margin-left: 12rpx;
}
.need-note {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #f0f2f8;
  font-size: 23rpx;
  color: #8a91a6;
  line-height: 1.6;
}

.section-title {
  margin: 40rpx 8rpx 18rpx;
  font-size: 26rpx;
  color: #8a91a6;
}

.opt-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}
.opt-card.top {
  box-shadow: 0 12rpx 32rpx rgba(91, 108, 255, 0.14);
}

.opt-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.opt-left {
  display: flex;
  align-items: center;
}
.opt-emoji {
  font-size: 52rpx;
  margin-right: 18rpx;
}
.opt-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1b1f33;
}
.opt-tag {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8a91a6;
}
.opt-prob {
  text-align: right;
  flex: none;
}
.prob-num {
  font-size: 56rpx;
  font-weight: 800;
  color: #5b6cff;
  line-height: 1;
}
.prob-pct {
  font-size: 26rpx;
  color: #5b6cff;
  margin-left: 2rpx;
}
.prob-label {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #a6aebc;
}

.bar {
  margin-top: 20rpx;
  height: 10rpx;
  border-radius: 5rpx;
  background: #eef0f7;
  overflow: hidden;
}
.bar-in {
  height: 100%;
  border-radius: 5rpx;
  background: linear-gradient(90deg, #7c8bff, #5b6cff);
}

.opt-way {
  margin-top: 24rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #4a5168;
}

.opt-meta {
  margin-top: 20rpx;
  background: #f7f8fc;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
}
.meta-row {
  display: flex;
  font-size: 24rpx;
  line-height: 1.7;
}
.meta-k {
  width: 120rpx;
  flex: none;
  color: #a6aebc;
}
.meta-v {
  flex: 1;
  color: #4a5168;
}

.opt-actions {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.pick-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 42rpx;
  background: linear-gradient(135deg, #6f7dff, #5b6cff);
  color: #fff;
  font-size: 29rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(91, 108, 255, 0.28);
}
.peek {
  margin-left: 20rpx;
  flex: none;
  font-size: 25rpx;
  color: #8a91a6;
  padding: 10rpx 4rpx;
}

.peek-list {
  margin-top: 24rpx;
  border-top: 2rpx dashed #eceef5;
  padding-top: 12rpx;
}
.peek-item {
  display: flex;
  padding: 14rpx 0;
}
.peek-date {
  width: 150rpx;
  flex: none;
  font-size: 23rpx;
  color: #a6aebc;
  padding-top: 4rpx;
}
.peek-body {
  flex: 1;
}
.peek-title {
  font-size: 27rpx;
  color: #1b1f33;
  line-height: 1.5;
}
.peek-tip {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #a6aebc;
  line-height: 1.5;
}

.reroll {
  margin: 12rpx auto 0;
  height: 88rpx;
  border-radius: 44rpx;
  border: 2rpx solid #dfe3ef;
  color: #4a5168;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-wrap {
  padding: 90rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.spinner {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 6rpx solid #eef0ff;
  border-top-color: #5b6cff;
  animation: spin 0.8s linear infinite;
}
.loading-text {
  margin-top: 24rpx;
  font-size: 27rpx;
  color: #8a91a6;
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.go-btn {
  margin: 40rpx 120rpx 0;
}
