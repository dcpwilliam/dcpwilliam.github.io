.container {
  padding: 20rpx;
  min-height: 100vh;
  background: #0a0e1a;
}

.intro-section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.section-desc {
  font-size: 26rpx;
  color: #8899aa;
  margin-top: 10rpx;
}

.strategy-select, .stock-select, .backtest-params {
  background: linear-gradient(145deg, #1a1f2e 0%, #151a25 100%);
  border: 1px solid #2a3441;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.select-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 20rpx;
}

.strategy-options {
  display: flex;
  gap: 16rpx;
}

.strategy-option {
  flex: 1;
  background: #2a3441;
  border: 1px solid #3a4451;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
}

.strategy-option.active {
  background: rgba(0, 212, 255, 0.15);
  border-color: #00d4ff;
}

.strategy-icon {
  font-size: 36rpx;
  margin-bottom: 10rpx;
}

.strategy-name {
  font-size: 24rpx;
  color: #e0e6ed;
}

.picker-btn {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #2a3441;
  border: 1px solid #3a4451;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #e0e6ed;
}

.picker-arrow {
  font-size: 20rpx;
  color: #8899aa;
}

.param-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 0;
  border-bottom: 1px solid #2a3441;
}

.param-label {
  font-size: 28rpx;
  color: #8899aa;
}

.param-input-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.param-input {
  background: #2a3441;
  border: 1px solid #3a4451;
  border-radius: 8rpx;
  padding: 12rpx 20rpx;
  font-size: 28rpx;
  color: #e0e6ed;
  width: 200rpx;
  text-align: right;
}

.param-unit {
  font-size: 24rpx;
  color: #8899aa;
}

.backtest-btn {
  background: linear-gradient(135deg, #00d4ff, #7b61ff);
  border-radius: 16rpx;
  padding: 28rpx;
  text-align: center;
  margin-bottom: 30rpx;
}

.btn-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.results-section {
  background: linear-gradient(145deg, #1a1f2e 0%, #151a25 100%);
  border: 1px solid #2a3441;
  border-radius: 16rpx;
  padding: 24rpx;
}

.results-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.result-card {
  background: #2a3441;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
}

.result-label {
  font-size: 24rpx;
  color: #8899aa;
  margin-bottom: 10rpx;
}

.result-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #e0e6ed;
}

.result-value.up {
  color: #00d4aa;
}

.result-value.down {
  color: #ff6b6b;
}